# RN/Expo generated native project at the repo root only — not asset folders
# named "android" (e.g. assets/brand/marketing/android/).
/android/
node_modules/
.expo/
gradle-dist.zip
releases/
app-logs.txt
.claude/

# Play Store service account key (secret — never commit)
play-service-account.json
branding/production/renders/

# Marketing video (large binaries — keep out of git history; live in cloud/local)
branding/Video/
branding/assets/video/
*.mp4

# Local sideload builds (debug-signed; never commit / never upload to a store)
*.apk
*.aab
